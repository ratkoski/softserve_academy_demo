{
  "datasets": [
    {
      "name": "5f933ae7",
      "displayName": "current_positions",
      "config": {
        "version": "1.1",
        "source": "SELECT icao24, callsign, operator, model, manufacturername, origin_country,\n       latitude, longitude, baro_altitude, velocity, true_track, on_ground,\n       altitude_band, snapshot_ts\nFROM dbr_dev.radekgryciukk_opensky.current_positions\nWHERE snapshot_ts >= (SELECT MAX(snapshot_ts) FROM dbr_dev.radekgryciukk_opensky.current_positions) - INTERVAL 10 MINUTES",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "c74b6c71",
      "displayName": "kpi",
      "config": {
        "version": "1.1",
        "source": "SELECT distinct_aircraft, total_observations, snapshots, last_snapshot_at, avg_altitude_m\nFROM dbr_dev.radekgryciukk_opensky.agg_kpi",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "08f289b9",
      "displayName": "hourly",
      "config": {
        "version": "1.1",
        "source": "SELECT full_date, day_name, is_weekend, hour_key, distinct_aircraft, observations,\n       avg_altitude_m, avg_velocity_ms, on_ground_count\nFROM dbr_dev.radekgryciukk_opensky.agg_hourly_traffic",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "658b8b74",
      "displayName": "by_operator",
      "config": {
        "version": "1.1",
        "source": "SELECT operator, manufacturername, distinct_aircraft, observations, avg_altitude_m\nFROM dbr_dev.radekgryciukk_opensky.agg_by_operator\nWHERE operator <> 'Unknown'\nORDER BY distinct_aircraft DESC\nLIMIT 15",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "f384e424",
      "displayName": "by_country",
      "config": {
        "version": "1.1",
        "source": "SELECT origin_country, distinct_aircraft, observations\nFROM dbr_dev.radekgryciukk_opensky.agg_by_country\nORDER BY distinct_aircraft DESC\nLIMIT 15",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
